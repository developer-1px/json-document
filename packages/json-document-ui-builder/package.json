{
  "name": "@interactive-os/json-document-ui-builder",
  "version": "0.1.0-rc.0",
  "description": "UI builder project Hand and schema-driven sample-data connector.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developer-1px/json-document.git",
    "directory": "packages/json-document-ui-builder"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "docs",
    "LICENSE",
    "src/ui-builder-workspace.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui-builder-workspace.css": "./src/ui-builder-workspace.css"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "pretypecheck": "node ../../scripts/workspace-tasks.mjs build-dependencies",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "peerDependencies": {
    "@interactive-os/json-document-editing": ">=0.1.0-rc.0 <1",
    "@interactive-os/json-document-react": ">=0.1.0-rc.0 <1",
    "@interactive-os/json-document-canvas": ">=0.1.0-rc.0 <1",
    "@interactive-os/json-document-database": ">=0.1.0-rc.0 <1",
    "@interactive-os/json-document-ui-primitives-react": ">=0.1.0-rc.0 <1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@interactive-os/json-document-editing": "*",
    "@interactive-os/json-document-react": "*",
    "@interactive-os/json-document-canvas": "*",
    "@interactive-os/json-document-database": "*",
    "@interactive-os/json-document-ui-primitives-react": "*",
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
