{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@interactive-os/json-document": [
        "./src/public/index.ts"
      ],
      "@interactive-os/json-document/react": [
        "./src/public/react.ts"
      ],
      "@interactive-os/json-document/patch": [
        "./src/public/patch.ts"
      ],
      "@interactive-os/json-document/pointer": [
        "./src/public/pointer.ts"
      ],
      "@interactive-os/json-document/selection": [
        "./src/public/selection.ts"
      ],
      "@interactive-os/json-document/text-surface": [
        "./src/public/text-surface.ts"
      ],
      "@interactive-os/json-document/schema": [
        "./src/public/schema.ts"
      ],
      "@interactive-os/json-document/clipboard": [
        "./src/public/clipboard.ts"
      ]
    },
    "types": [
      "node"
    ],
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
