{
  "name": "@interactive-os/json-document-markdown-web",
  "version": "0.1.0-rc.0",
  "description": "DOM projection of Markdown source with selection-aware delimiters.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developer-1px/json-document.git",
    "directory": "packages/json-document-markdown-web"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "docs",
    "LICENSE",
    "src/markdown-editor.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./markdown-editor.css": "./src/markdown-editor.css"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -b tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "pretypecheck": "node ../../scripts/workspace-tasks.mjs build-dependencies",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@interactive-os/json-document-markdown": "^0.1.0-rc.0",
    "@interactive-os/json-document-contenteditable": "^0.1.0-rc.0",
    "@interactive-os/json-document-editing": "^0.1.0-rc.0",
    "@interactive-os/json-document-web": "^0.1.0-rc.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7",
    "@interactive-os/json-document-markdown": "*",
    "@interactive-os/json-document-contenteditable": "*",
    "jsdom": "^29.1.1",
    "@interactive-os/json-document-editing": "*",
    "@interactive-os/json-document-web": "*"
  }
}
