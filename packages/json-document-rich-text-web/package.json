{
  "name": "@interactive-os/json-document-rich-text-web",
  "version": "0.1.0-rc.0",
  "description": "Official DOM, contenteditable, HTML, and Clipboard integration for json-document Rich Text.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developer-1px/json-document.git",
    "directory": "packages/json-document-rich-text-web"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/.tsbuildinfo", "README.md", "LICENSE"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run build -w @interactive-os/json-document-rich-text && npm run build -w @interactive-os/json-document-web",
    "build": "npm run clean && tsc -p tsconfig.json",
    "pretypecheck": "npm run prebuild",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@interactive-os/json-document-rich-text": "^0.1.0-rc.0",
    "@interactive-os/json-document-web": "^0.1.0-rc.0"
  },
  "devDependencies": {
    "@interactive-os/json-document-rich-text": "*",
    "@interactive-os/json-document-web": "*",
    "@types/node": "^25.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
