{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@interactive-os/json-document-collaboration": [
        "../json-document-collaboration/dist/index.d.ts"
      ],
      "@interactive-os/json-document-collaboration/text": [
        "../json-document-collaboration/dist/text-index.d.ts"
      ]
    },
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
