{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@interactive-os/json-document": [
        "../json-document/src/application/document/index.ts"
      ],
      "@interactive-os/json-document-collaboration": [
        "./src/index.ts"
      ]
    },
    "types": [
      "node"
    ],
    "noEmit": true,
    "rootDir": "../..",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "../../standards/json-document-v3/conformance/suites/json-document.ts",
    "../../standards/json-document-v3/conformance/suites/pressure.ts",
    "vitest.config.ts"
  ]
}
