{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interactive-os:json-document:rich-text:1",
  "title": "JSONDocument Rich Text v1",
  "$ref": "#/$defs/document",
  "$defs": {
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "document": {
      "type": "object",
      "required": ["profile", "id", "type", "content"],
      "properties": {
        "profile": {
          "const": "urn:interactive-os:json-document:rich-text:1"
        },
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "doc" },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      },
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/blockquote" },
        { "$ref": "#/$defs/codeBlock" },
        { "$ref": "#/$defs/bulletList" },
        { "$ref": "#/$defs/orderedList" }
      ]
    },
    "paragraph": {
      "type": "object",
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "paragraph" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inline" }
        }
      },
      "additionalProperties": false
    },
    "heading": {
      "type": "object",
      "required": ["id", "type", "attrs", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "heading" },
        "attrs": {
          "type": "object",
          "required": ["level"],
          "properties": {
            "level": { "type": "integer", "minimum": 1, "maximum": 6 }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inline" }
        }
      },
      "additionalProperties": false
    },
    "blockquote": {
      "type": "object",
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "blockquote" },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      },
      "additionalProperties": false
    },
    "codeBlock": {
      "type": "object",
      "required": ["id", "type", "attrs", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "codeBlock" },
        "attrs": {
          "type": "object",
          "required": ["language"],
          "properties": {
            "language": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/plainText" }
        }
      },
      "additionalProperties": false
    },
    "bulletList": {
      "type": "object",
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "bulletList" },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/listItem" }
        }
      },
      "additionalProperties": false
    },
    "orderedList": {
      "type": "object",
      "required": ["id", "type", "attrs", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "orderedList" },
        "attrs": {
          "type": "object",
          "required": ["start"],
          "properties": {
            "start": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/listItem" }
        }
      },
      "additionalProperties": false
    },
    "listItem": {
      "type": "object",
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "listItem" },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      },
      "additionalProperties": false
    },
    "inline": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/hardBreak" }
      ]
    },
    "text": {
      "type": "object",
      "required": ["id", "type", "text", "marks"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1 },
        "marks": {
          "type": "array",
          "items": { "$ref": "#/$defs/mark" }
        }
      },
      "additionalProperties": false
    },
    "plainText": {
      "type": "object",
      "required": ["id", "type", "text", "marks"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1 },
        "marks": { "const": [] }
      },
      "additionalProperties": false
    },
    "hardBreak": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "hardBreak" }
      },
      "additionalProperties": false
    },
    "mark": {
      "oneOf": [
        { "$ref": "#/$defs/strongMark" },
        { "$ref": "#/$defs/emphasisMark" },
        { "$ref": "#/$defs/underlineMark" },
        { "$ref": "#/$defs/strikethroughMark" },
        { "$ref": "#/$defs/codeMark" },
        { "$ref": "#/$defs/linkMark" }
      ]
    },
    "strongMark": { "$ref": "#/$defs/plainStrongMark" },
    "plainStrongMark": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "strong" } },
      "additionalProperties": false
    },
    "emphasisMark": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "emphasis" } },
      "additionalProperties": false
    },
    "underlineMark": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "underline" } },
      "additionalProperties": false
    },
    "strikethroughMark": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "strikethrough" } },
      "additionalProperties": false
    },
    "codeMark": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "code" } },
      "additionalProperties": false
    },
    "linkMark": {
      "type": "object",
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "link" },
        "attrs": {
          "type": "object",
          "required": ["href"],
          "properties": {
            "href": { "type": "string" },
            "title": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
